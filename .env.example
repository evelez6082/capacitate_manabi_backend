DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/capacitate_manabi_bd_v2
APP_NAME=Capacitate Manabi API
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
AUTH_SECRET_KEY=CAMBIA_ESTA_CLAVE_LARGA_Y_ALEATORIA
AUTH_TOKEN_EXPIRE_MINUTES=720
PUBLIC_FORM_MIN_SECONDS=3
PUBLIC_FORM_MAX_SECONDS=1800
RATE_LIMIT_IP_ATTEMPTS=10
RATE_LIMIT_IP_WINDOW_SECONDS=900
RATE_LIMIT_IDENTITY_ATTEMPTS=3
RATE_LIMIT_IDENTITY_WINDOW_SECONDS=3600
RATE_LIMIT_EMAIL_ATTEMPTS=3
RATE_LIMIT_EMAIL_WINDOW_SECONDS=3600
# Configura este encabezado solo si la API está detrás de un proxy confiable.
CLIENT_IP_HEADER=

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Capacitate Manabi
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SUPPORT_EMAIL=formacion@manabi.gob.ec

# Reportes proactivos mediante WhatsApp Cloud API. Mantener apagado hasta crear
# y aprobar la plantilla indicada en Meta; no versionar el token real.
WHATSAPP_REPORTS_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_REPORT_RECIPIENT=
WHATSAPP_REPORT_TEMPLATE=reporte_inscripciones_diarias
WHATSAPP_REPORT_TEMPLATE_LANGUAGE=es
WHATSAPP_REPORT_TIMEZONE=America/Guayaquil
DAILY_REPORT_EMAIL_ENABLED=false
DAILY_REPORT_EMAIL_RECIPIENT=
